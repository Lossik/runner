parameters:
	level: max
	paths:
		- src
	ignoreErrors:
		# The job configuration is not validated: createService() and create() get mixed values from it. A type guard would
		# change behaviour (a processor without class/service and a non-string class or setup end with TypeError, X7).
		-
			identifier: argument.type
			path: src/Runner.php
			count: 5
		# include given as a value that is neither a string nor an array (e.g. include: 5) ends with TypeError
		# (tests/IncludeTest.php holds it); a guard would change that behaviour.
		# realpath() of a path that is_dir()/is_file() just confirmed may still be typed string|false. Compiler::addDependencies()
		# already drops a false entry (array_filter); for a file, false reaches $neon->load(), is coerced to '' and reading
		# the empty path throws. Filtering out a false result would turn that error into a silent skip (behaviour change).
		-
			identifier: argument.type
			path: src/RunnerExtension.php
			count: 2
		-
			identifier: return.type
			path: src/RunnerExtension.php
			count: 1
